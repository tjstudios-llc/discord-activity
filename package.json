{
  "name": "teamspace-discord-activity",
  "version": "0.1.0",
  "private": true,
  "description": "Top-down multiplayer PvP Discord Activity with persistent progression",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:activity": "pnpm --filter @teamspace/activity dev",
    "dev:api": "pnpm --filter @teamspace/api dev",
    "dev:realtime": "pnpm --filter @teamspace/realtime dev",
    "dev": "pnpm --parallel --filter @teamspace/activity --filter @teamspace/api --filter @teamspace/realtime dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @teamspace/database db:generate",
    "db:validate": "pnpm --filter @teamspace/database db:validate",
    "db:migrate": "pnpm --filter @teamspace/database db:migrate",
    "dev:dashboard": "pnpm --filter @teamspace/dashboard dev",
    "db:deploy": "pnpm --filter @teamspace/database db:deploy"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "@eslint/js": "^9.24.0",
    "globals": "^16.0.0"
  }
}
