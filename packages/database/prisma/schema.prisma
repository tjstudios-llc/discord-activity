generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TeamRole {
  OWNER
  ADMIN
  EDITOR
  MEMBER
  VIEWER
}

enum GameItemType {
  CHARACTER
  WEAPON
  SKIN
}

enum GameMode {
  TEAM
  FREE_FOR_ALL
}

enum GameMatchStatus {
  WAITING
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

model User {
  id            String                @id @default(cuid())
  discordId     String                @unique
  username      String
  displayName   String?
  avatar        String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  memberships   TeamMember[]
  preferences   WorkspacePreference[]
  createdTasks  Task[]                @relation("TaskCreator")
  assignedTasks Task[]                @relation("TaskAssignee")
  notes         Note[]
  auditEvents   AuditEvent[]
  sessions      AuthSession[]
  gameProfile   GameProfile?
  gameInventory GameInventory[]
  gameMatches   GameMatchPlayer[]
}

model Team {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  discordGuildId String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  members        TeamMember[]
  workspaces     Workspace[]
  auditEvents    AuditEvent[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId, role])
}

model Workspace {
  id          String                @id @default(cuid())
  teamId      String
  name        String
  slug        String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  team        Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  theme       WorkspaceTheme?
  layout      WorkspaceLayout?
  features    WorkspaceFeature[]
  preferences WorkspacePreference[]
  tasks       Task[]
  notes       Note[]

  @@unique([teamId, slug])
  @@index([teamId])
}

model WorkspaceTheme {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  version     Int       @default(1)
  config      Json
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceLayout {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  version     Int       @default(1)
  config      Json
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceFeature {
  id          String    @id @default(cuid())
  workspaceId String
  key         String
  enabled     Boolean   @default(true)
  config      Json?
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

model WorkspacePreference {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  config      Json
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Task {
  id           String     @id @default(cuid())
  workspaceId  String
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  position     Int        @default(0)
  createdById  String
  assignedToId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo   User?      @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, position])
  @@index([assignedToId])
}

model Note {
  id          String    @id @default(cuid())
  workspaceId String
  authorId    String
  title       String    @default("")
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, updatedAt])
}

model AuditEvent {
  id           String   @id @default(cuid())
  teamId       String
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([actorId, createdAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}


model GameProfile {
  id                  String          @id @default(cuid())
  userId              String          @unique
  xp                  Int             @default(0)
  level               Int             @default(1)
  coins               Int             @default(150)
  kills               Int             @default(0)
  deaths              Int             @default(0)
  wins                Int             @default(0)
  losses              Int             @default(0)
  selectedCharacterId String          @default("rookie")
  selectedWeaponId    String          @default("blaster")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([level, xp])
  @@index([wins, kills])
}

model GameItem {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  type        GameItemType
  description String
  price       Int             @default(0)
  unlockLevel Int             @default(1)
  rarity      String          @default("common")
  stats       Json
  isStarter   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  inventory   GameInventory[]

  @@index([type, unlockLevel])
}

model GameInventory {
  id          String   @id @default(cuid())
  userId      String
  itemId      String
  acquiredAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item        GameItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, acquiredAt])
}

model GameMatch {
  id        String             @id @default(cuid())
  mode      GameMode
  status    GameMatchStatus    @default(WAITING)
  startedAt DateTime           @default(now())
  endedAt   DateTime?
  players   GameMatchPlayer[]

  @@index([mode, status, startedAt])
}

model GameMatchPlayer {
  id         String    @id @default(cuid())
  matchId    String
  userId     String
  team       String?
  kills      Int       @default(0)
  deaths     Int       @default(0)
  placement  Int?
  xpEarned   Int       @default(0)
  coinsEarned Int      @default(0)
  createdAt  DateTime  @default(now())
  match      GameMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId, createdAt])
}
